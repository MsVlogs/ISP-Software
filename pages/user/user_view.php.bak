<?php include('user.php'); ?>
<?php
// Handle Password Update Logic
if (isset($_POST['passwordupdate'])) {
    $passwordid = $_POST['passwordid'];
    $password = $_POST['password'];
    $confirmPassword = $_POST['confirmpassword'];

    if ($password === $confirmPassword) {
        $hashedPassword = md5($password); // Using md5 to match common legacy patterns, though password_hash is preferred
        $updateData = ['Password' => $hashedPassword];
        $where = ['UserId' => $passwordid];
        
        if ($obj->updateData("_createuser", $updateData, $where)) {
            echo "<script>alert('Password updated successfully!'); window.location.href=window.location.href;</script>";
        } else {
            echo "<script>alert('Failed to update password.');</script>";
        }
    }
}
?>
